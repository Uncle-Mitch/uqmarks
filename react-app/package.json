{
    "name": "react-app",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "npm run build:dash && vite",
        "test": "vitest run",
        "build": "npm run build:dash && tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.dash.json --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "build:dash": "tsc -p tsconfig.dash.json",
        "dev:dash": "tsc -p tsconfig.dash.json --watch"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.3.1",
        "@mdi/font": "^7.4.47",
        "@vueuse/core": "^14.4.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "sass": "^1.105.1",
        "sass-loader": "^16.0.8",
        "vue": "^3.5.44",
        "vue-router": "^4.6.4",
        "vuetify": "^3.13.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^25.9.9",
        "@vitejs/plugin-vue": "^6.0.10",
        "eslint": "^9.39.5",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^7.3.7",
        "vite-plugin-vuetify": "^2.1.3",
        "vitest": "^5.1.0",
        "vue-tsc": "^3.3.13"
    }
}
